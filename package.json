{
  "name": "claude",
  "version": "0.1.0",
  "description": "Claude Code integration plugin for Agent of Empires",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claude-worker": ".aoe-build/dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:parity": "cargo test --locked --manifest-path tests/manifest/Cargo.toml && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.2"
  }
}
